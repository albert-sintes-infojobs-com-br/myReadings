# Motor de base de datos usado por Prisma: "postgresql" (por defecto) o "mysql".
# Selecciona el schema/migraciones de prisma/<DB_PROVIDER>/ (ver scripts/run-prisma.js).
DB_PROVIDER=postgresql

# Postgres (por defecto)
DATABASE_URL="postgresql://myreadings:myreadings@db:5432/myreadings?schema=public"

# MySQL/MariaDB (alternativa): descomenta esta linea, comenta la de arriba,
# y pon DB_PROVIDER=mysql para usar este motor.
# DATABASE_URL="mysql://myreadings:myreadings@db:3306/myreadings?schema=public"

# JWT (usadas por AuthService/JwtStrategy)
JWT_SECRET="cambia-este-secreto-en-produccion"
JWT_EXPIRES_IN="1h"

# API
PORT=3000
